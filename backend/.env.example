# Crisoverde Bot (Gemini) — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# A chave fica SOMENTE no backend (e nas variáveis do Railway) — nunca no frontend.

# ─── IA: Google Gemini ────────────────────────────────────────────────────
# Chave da API (obtenha no Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=sua_chave_aqui

# Modelo principal. Confira os nomes válidos em https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# (Opcional) Modelo reserva, usado se o principal estourar a cota (429) ou ficar instável.
# Deixe vazio para não usar. É sempre outro modelo Gemini — não há outro provedor.
GEMINI_FALLBACK_MODEL=

# Limite de tokens da resposta. Padrão deste projeto: 1536
GEMINI_MAX_OUTPUT_TOKENS=1536

# Tempo máximo por chamada, em milissegundos. Até 3 tentativas para falha transitória, dentro de um prazo total de 2x esse valor (o dobro por chamada se houver imagem/PDF). Padrão: 20000
GEMINI_TIMEOUT_MS=20000

# (Opcional) Nível de raciocínio dos modelos Gemini 3: low | medium | high (minimal só em alguns modelos).
# ATENÇÃO: a documentação oficial do gemini-3.8-flash diz que "minimal" NÃO é suportado e retorna erro.
# Use somente se o modelo selecionado documentar suporte a este parâmetro. Vazio = padrão do modelo.
# Se o modelo recusar o nível (HTTP 400), o backend repete sem ele e lembra da recusa nas próximas chamadas.
GEMINI_THINKING_LEVEL=low

# (Opcional) Temperatura de 0 a 2. Vazio = padrão do modelo (recomendado).
GEMINI_TEMPERATURE=

# (Opcional) Máximo de chamadas por MINUTO ao Gemini neste servidor (0 = desligado).
# Use um valor um pouco abaixo do RPM do SEU modelo/plano (veja em https://aistudio.google.com/rate-limit).
# O servidor segura/recusa o excedente com uma mensagem amigável em vez de tomar 429 do Google.
GEMINI_MAX_RPM=0

# Contexto enviado a cada chamada: máximo de mensagens do histórico e orçamento de caracteres.
GEMINI_MAX_HISTORY_MESSAGES=12
GEMINI_HISTORY_CHAR_BUDGET=12000

# (Avançado/testes) URL base da API. Só altere para testes locais com servidor simulado.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Porta do servidor (padrão: 3001)
PORT=3001

# Ambiente (development | production)
NODE_ENV=development

# Origens permitidas no CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Limite de requisições por IP por minuto
RATE_LIMIT_MAX=30

# Limite DIÁRIO de mensagens para a IA (controle de custo). Conta as últimas 24h.
# Por usuário (padrão 100; 0 = sem limite). Administradores não são limitados.
CHAT_DAILY_LIMIT_PER_USER=100
# Teto GLOBAL de mensagens de todos os usuários nas últimas 24h (0 = sem limite).
# Recomendado definir um valor, já que qualquer pessoa pode criar conta.
CHAT_DAILY_LIMIT_GLOBAL=0

# Token fixo para as rotas administrativas legadas (/memory, /security/*)
ADMIN_TOKEN=gere_com_openssl_rand_hex_32

# Segredo usado para assinar os JWTs de sessão (login/cadastro).
# Gere com: openssl rand -hex 32
JWT_SECRET=gere_com_openssl_rand_hex_32

# String de conexão do PostgreSQL (Railway)
DATABASE_URL=postgresql://usuario:senha@host:porta/banco

# ─── Busca na web (OPCIONAL) ──────────────────────────────────────────────
# Se deixar em branco/"none", o bot NÃO pesquisa na internet: a CRISO.AI avisa
# que não consegue confirmar dados em tempo real (não simula pesquisa).
# Se configurar um provider abaixo, o bot busca no provider escolhido e mostra
# as fontes usadas ao final da resposta.

# "serper" (https://serper.dev) ou "tavily" (https://tavily.com) ou "none"
SEARCH_PROVIDER=none

# Chave do provider escolhido acima
SEARCH_API_KEY=

# Timeout da pesquisa em milissegundos (padrão: 5000 = 5s)
SEARCH_TIMEOUT=5000

# Tempo de cache dos resultados em segundos (padrão: 300 = 5min)
CACHE_TTL=300

# ─── Avaliação (OPCIONAL — só usado por `npm run eval:live`, nunca pelo servidor) ───────
# Preço por 1 MILHÃO de tokens em USD, copiado da página oficial de preços do modelo que você usa
# (https://ai.google.dev/gemini-api/docs/pricing). Sem isso o relatório mostra tokens, mas não custo.
EVAL_PRICE_INPUT_PER_MTOK=
EVAL_PRICE_OUTPUT_PER_MTOK=
