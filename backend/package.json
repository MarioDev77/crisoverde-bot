{
  "name": "crisoverde-bot",
  "version": "1.0.0",
  "description": "Backend do Chatbot Crisoverde (CRISO.AI) com Google Gemini",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node -r ts-node/register/transpile-only tests/gemini.mock.test.ts && node -r ts-node/register/transpile-only tests/memory.test.ts && node -r ts-node/register/transpile-only tests/security.test.ts && node -r ts-node/register/transpile-only tests/markdown.test.ts && node -r ts-node/register/transpile-only tests/detection.test.ts",
    "test:db": "node -r ts-node/register/transpile-only tests/pg.integration.test.ts",
    "test:e2e": "node -r ts-node/register/transpile-only tests/e2e.test.ts",
    "eval": "node -r ts-node/register/transpile-only evals/run.ts",
    "eval:live": "node -r ts-node/register/transpile-only evals/run.ts --live"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.21.0",
    "undici": "^6.21.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.20.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
